    "definitions": {
        "dto.AddDriverRequest": {
            "type": "object",
            "required": [
                "carBrand",
                "carModel",
                "firstName",
                "lastName",
                "lat",
                "lon",
                "plate",
                "taxiType"
            ],
            "properties": {
                "carBrand": {
                    "type": "string"
                },
                "carModel": {
                    "type": "string"
                },
                "firstName": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2
                },
                "lastName": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "plate": {
                    "type": "string",
                    "maxLength": 9,
                    "minLength": 6
                },
                "taxiType": {
                    "type": "string",
                    "enum": [
                        "sari",
                        "korsan",
                        "uber",
                        "tag"
                    ]
                }
            }
        },
        "dto.CreateTokenResponse": {
